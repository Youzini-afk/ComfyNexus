# --- ComfyNexus environment template ---
# Copy this file to .env for local development. On Zeabur, configure these in the
# service Variables tab. Never commit a real .env to source control.

# Bind address. Zeabur injects PORT automatically. Locally defaults to 8080.
PORT=8080

# Master key seed for at-rest encryption (AES-GCM KEK derived from this).
# Generate a strong random string: openssl rand -base64 48
COMFYNEXUS_MASTER_KEY=

# Persistent data directory. On Zeabur, mount a Volume here.
COMFYNEXUS_DATA_DIR=./data

# Logging: debug | info | warn | error
COMFYNEXUS_LOG_LEVEL=info

# Optional: trust X-Forwarded-* headers (true behind Zeabur ingress).
COMFYNEXUS_TRUST_PROXY=true

# Optional: require this token for the first /api/auth/setup call. Send via
# X-Setup-Token header or JSON body field "token".
COMFYNEXUS_SETUP_TOKEN=

# SSH host-key verification is strict by default. Add each instance's
# SHA256 host fingerprint in the UI/API. For local/dev only, restore legacy
# trust-any-host behavior explicitly:
COMFYNEXUS_INSECURE_SKIP_HOST_KEY_CHECK=false

# Per-upload-chunk limit in bytes. Defaults to 50MiB and is capped at 100MiB.
COMFYNEXUS_UPLOAD_CHUNK_MAX_BYTES=52428800

# Optional: Civitai API token for higher rate limits and download support.
CIVITAI_API_KEY=

# Optional: HuggingFace token for gated model downloads via remote aria2c.
HF_TOKEN=
